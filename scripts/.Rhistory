tag = "A") +
theme_minimal(base_size = 11) +
theme(
panel.grid.minor = element_blank(),
panel.grid.major.x = element_blank(),
legend.position = "bottom",
legend.key.size = unit(0.5, "cm"),
plot.margin = margin(8, 10, 4, 10)
)
decomp_long <- decomp |>
select(year,
Composition = composition_effect, comp_lo = composition_effect_lo,
comp_hi = composition_effect_hi,
Rate = rate_effect, rate_lo = rate_effect_lo, rate_hi = rate_effect_hi) |>
pivot_longer(c(Composition, Rate),
names_to = "Component", values_to = "Contribution") |>
mutate(
Component = factor(Component, levels = c("Composition", "Rate")),
lo = if_else(Component == "Composition", comp_lo, rate_lo),
hi = if_else(Component == "Composition", comp_hi, rate_hi)
)
p_b <- ggplot(decomp_long,
aes(x = year, y = Contribution, fill = Component, color = Component)) +
geom_col(position = position_dodge(width = 0.85), width = 0.78,
color = NA) +
geom_errorbar(aes(ymin = lo, ymax = hi),
position = position_dodge(width = 0.85),
width = 0.35, linewidth = 0.4, color = "gray25") +
geom_vline(xintercept = 2020, linetype = "dashed", color = "gray50", linewidth = 0.3) +
scale_fill_manual(values = colors_comp_rate) +
scale_color_manual(values = colors_comp_rate, guide = "none") +
scale_x_continuous(breaks = seq(2005, 2025, by = 5)) +
scale_y_continuous(expand = expansion(mult = c(0.05, 0.05))) +
labs(x = NULL, y = "Contribution to gap\n(deaths per 1,000 live births)",
fill = NULL, tag = "B") +
theme_minimal(base_size = 11) +
theme(
panel.grid.minor = element_blank(),
panel.grid.major.x = element_blank(),
legend.position = "bottom",
legend.key.size = unit(0.5, "cm"),
plot.margin = margin(4, 10, 8, 10)
)
p_a / p_b
fig1 <- p_a / p_b
#### Preamble ####
# Purpose: Create figures and tables for JAMA NO paper
# Author: Monica Alexander
# Date: 2026-09-20
library(tidyverse)
library(knitr)
library(patchwork)
# Set-up ------------------------------------------------------------------
colors_comp_rate <- c("Composition" = "#d4a373", "Rate" = "#588157")
decomp <- read_csv(here::here("data/analysis_data/decomposition_results_with_ci.csv"),
show_col_types = FALSE)
cause_decomp <- read_csv(here::here("data/analysis_data/cause_decomposition_with_ci.csv"),
show_col_types = FALSE)
imr_ci <- read_csv(here::here("data/analysis_data/imr_with_ci.csv"),
show_col_types = FALSE)
detailed_ci <- read_csv(here::here("data/analysis_data/detailed_decomposition_with_ci.csv"),
show_col_types = FALSE)
exclusion_counts <- read_csv(here::here("data/analysis_data/exclusion_counts.csv"),
show_col_types = FALSE)
first_year <- min(decomp$year)
last_year <- max(decomp$year)
analysis_data <- read_csv(here::here("data/analysis_data/analysis_data.csv"),
show_col_types = FALSE) |>
filter(year >= 2003)
total_births <- analysis_data |>
filter(year >= first_year, year <= last_year) |>
pull(births) |> sum()
# Live births excluded solely for unknown/missing Hispanic origin (mhisp not 0
# among White/Black-race mothers), and the total source birth records, used to
# report the exclusion in the Methods.
hisp_unknown_excl <- exclusion_counts |>
filter(year >= first_year, file_type == "births") |>
pull(excluded_hispanic_unknown) |> sum()
total_birth_records <- exclusion_counts |>
filter(year >= first_year, file_type == "births") |>
pull(total_records) |> sum()
first <- decomp |> filter(year == first_year)
last <- decomp |> filter(year == last_year)
pre_pandemic <- decomp |> filter(year == 2019)
y2020 <- decomp |> filter(year == 2020)
avg_comp <- mean(decomp$composition_pct)
# Preterm (<37 weeks) birth share by race, pooled over the study period
# (sum of the four preterm gestational-age groups' birth proportions).
preterm_share <- analysis_data |>
mutate(preterm = gestational_age_group %in%
c("<28 weeks", "28-31 weeks", "32-33 weeks", "34-36 weeks")) |>
summarise(pct = 100 * sum(births[preterm]) / sum(births), .by = race)
preterm_black <- preterm_share |> filter(race == "Non-Hispanic Black") |> pull(pct)
preterm_white <- preterm_share |> filter(race == "Non-Hispanic White") |> pull(pct)
# Gestational-age-scheme sensitivity: composition/rate split by scheme, last year
ga_scheme <- read_csv(here::here("data/analysis_data/ga_scheme_comparison.csv"),
show_col_types = FALSE)
ga_scheme_last <- ga_scheme |> filter(year == last_year)
scheme5_last <- ga_scheme_last |> filter(scheme == "5-category")
scheme7_last <- ga_scheme_last |> filter(scheme == "7-category")
cause_last <- cause_decomp |> filter(year == last_year)
cause_2020 <- cause_decomp |> filter(year == 2020)
suid_last <- cause_last |> filter(cause_of_death == "Sudden unexpected infant death")
suid_2020 <- cause_2020 |> filter(cause_of_death == "Sudden unexpected infant death")
cause_change <- cause_last |>
select(cause_of_death, gap_last = gap) |>
left_join(cause_2020 |> select(cause_of_death, gap_2020 = gap),
by = "cause_of_death") |>
mutate(abs_change = gap_last - gap_2020) |>
arrange(desc(abs_change))
total_widening <- sum(cause_change$abs_change)
suid_widening <- cause_change |>
filter(cause_of_death == "Sudden unexpected infant death") |>
pull(abs_change)
# SUID three-component split (eTable 2 / eFigure 2): change in each component's
# contribution to the gap from 2020 to the last year, used in the Discussion.
suid_split_chg <- read_csv(
here::here("data/analysis_data/cause_decomposition_suid_split.csv"),
show_col_types = FALSE
) |>
filter(cause_of_death %in% c("SIDS (R95)",
"Accidental suffocation in bed (W75)",
"Ill-defined/unspecified (R99)"),
year %in% c(2020, last_year)) |>
summarise(change = gap[year == last_year] - gap[year == 2020],
.by = cause_of_death)
suid_r99_change  <- suid_split_chg |>
filter(cause_of_death == "Ill-defined/unspecified (R99)") |> pull(change)
suid_w75_change  <- suid_split_chg |>
filter(cause_of_death == "Accidental suffocation in bed (W75)") |> pull(change)
suid_sids_change <- suid_split_chg |>
filter(cause_of_death == "SIDS (R95)") |> pull(change)
n_study_years <- last_year - first_year + 1
mid_cause_gaps <- cause_last |>
filter(cause_of_death %in% c("Congenital malformations",
"Maternal complications", "Infection")) |>
pull(gap)
# Fixed-decimal inline formatters so trailing zeros are preserved in the prose
# (base round() drops them, e.g. 13.0 -> "13"). f1: 1 dp, f2: 2 dp.
f1 <- function(x) sprintf("%.1f", x)
f2 <- function(x) sprintf("%.2f", x)
# Signed 2-dp formatter for inline deltas: "+0.12" / "-0.05" / "0.00".
# Computes the sign (so prose need not hardcode "+"), snaps near-zero values
# so it never prints "-0.00", and degrades to "NA" rather than an empty string
# if the upstream value is missing (e.g. a dropped component-year cell).
fmt_signed <- function(x) {
if (length(x) == 0 || is.na(x)) return("NA")
if (abs(x) < 0.005) return("0.00")
sprintf("%+.2f", x)
}
# Point estimate with parenthetical CI for tables: "x.xx (lo to hi)".
# Non-breaking space before "(" keeps value and CI together; "to" (not a
# hyphen) so negative CI bounds read unambiguously, e.g. "-0.27 (-0.28 to -0.26)".
fmt_pt_ci <- function(pt, lo, hi, digits = 2) {
sprintf("%.*f (%.*f to %.*f)", digits, pt, digits, lo, digits, hi)
}
# Render a per-GA detailed decomposition table (eTables 4-6) from a
# saved CSV, for the given year (default: most recent), ordered by GA levels.
detailed_ga_table <- function(path, ga_levels, yr = last_year) {
read_csv(here::here(path), show_col_types = FALSE) |>
filter(year == yr) |>
mutate(gestational_age_group = factor(gestational_age_group,
levels = ga_levels)) |>
arrange(gestational_age_group) |>
transmute(
`Gestational age` = as.character(gestational_age_group),
`Black prop.` = sprintf("%.3f", prop_black),
`White prop.` = sprintf("%.3f", prop_white),
`Black IMR` = sprintf("%.2f", mortality_black),
`White IMR` = sprintf("%.2f", mortality_white),
`Composition` = fmt_pt_ci(composition_contribution, comp_lo, comp_hi),
`Rate` = fmt_pt_ci(rate_contribution, rate_lo, rate_hi),
`Total` = fmt_pt_ci(total_contribution, total_lo, total_hi)
) |>
kable(align = c("l", rep("r", 7)))
}
# Figure 1 ----------------------------------------------------------------
imr_plot_data <- imr_ci |>
mutate(Race = recode(race,
"Non-Hispanic Black" = "Black",
"Non-Hispanic White" = "White"))
p_a <- ggplot(imr_plot_data, aes(x = year, y = imr, color = Race, fill = Race)) +
geom_ribbon(aes(ymin = lo, ymax = hi), alpha = 0.20, color = NA) +
geom_line(linewidth = 1.0) +
geom_vline(xintercept = 2020, linetype = "dashed", color = "gray50", linewidth = 0.3) +
scale_color_manual(values = c("Black" = "#2c2c2c", "White" = "#7d7d7d")) +
scale_fill_manual(values = c("Black" = "#2c2c2c", "White" = "#7d7d7d")) +
scale_x_continuous(breaks = seq(2005, 2025, by = 5)) +
scale_y_continuous(limits = c(0, NA), expand = expansion(mult = c(0, 0.05))) +
labs(x = NULL, y = "Deaths per 1,000\nlive births", color = NULL, fill = NULL,
tag = "A") +
theme_minimal(base_size = 11) +
theme(
panel.grid.minor = element_blank(),
panel.grid.major.x = element_blank(),
legend.position = "bottom",
legend.key.size = unit(0.5, "cm"),
plot.margin = margin(8, 10, 4, 10)
)
decomp_long <- decomp |>
select(year,
Composition = composition_effect, comp_lo = composition_effect_lo,
comp_hi = composition_effect_hi,
Rate = rate_effect, rate_lo = rate_effect_lo, rate_hi = rate_effect_hi) |>
pivot_longer(c(Composition, Rate),
names_to = "Component", values_to = "Contribution") |>
mutate(
Component = factor(Component, levels = c("Composition", "Rate")),
lo = if_else(Component == "Composition", comp_lo, rate_lo),
hi = if_else(Component == "Composition", comp_hi, rate_hi)
)
p_b <- ggplot(decomp_long,
aes(x = year, y = Contribution, fill = Component, color = Component)) +
geom_col(position = position_dodge(width = 0.85), width = 0.78,
color = NA) +
geom_errorbar(aes(ymin = lo, ymax = hi),
position = position_dodge(width = 0.85),
width = 0.35, linewidth = 0.4, color = "gray25") +
geom_vline(xintercept = 2020, linetype = "dashed", color = "gray50", linewidth = 0.3) +
scale_fill_manual(values = colors_comp_rate) +
scale_color_manual(values = colors_comp_rate, guide = "none") +
scale_x_continuous(breaks = seq(2005, 2025, by = 5)) +
scale_y_continuous(expand = expansion(mult = c(0.05, 0.05))) +
labs(x = NULL, y = "Contribution to gap\n(deaths per 1,000 live births)",
fill = NULL, tag = "B") +
theme_minimal(base_size = 11) +
theme(
panel.grid.minor = element_blank(),
panel.grid.major.x = element_blank(),
legend.position = "bottom",
legend.key.size = unit(0.5, "cm"),
plot.margin = margin(4, 10, 8, 10)
)
p_a / p_b
fig1 <- p_a / p_b
# Figure 2 ----------------------------------------------------------------
top_causes <- cause_last |>
filter(cause_of_death != "Other") |>
arrange(desc(gap)) |> slice(1:6) |> pull(cause_of_death)
cause_palette <- c(
"#1b9e77", "#d95f02", "#7570b3", "#e7298a", "#66a61e", "#e6ab02"
)
fig2 <- cause_decomp |>
filter(cause_of_death %in% top_causes) |>
mutate(cause_of_death = factor(cause_of_death, levels = top_causes)) |>
ggplot(aes(x = year, y = rate_effect, color = cause_of_death, fill = cause_of_death)) +
geom_vline(xintercept = 2020, linetype = "dashed", color = "gray50", linewidth = 0.3) +
geom_ribbon(aes(ymin = rate_lo, ymax = rate_hi), alpha = 0.15, color = NA) +
geom_line(linewidth = 0.9) +
scale_color_manual(values = cause_palette) +
scale_fill_manual(values = cause_palette) +
scale_x_continuous(breaks = seq(2005, 2025, by = 5)) +
labs(x = NULL, y = "Rate effect\n(deaths per 1,000 live births)",
color = NULL, fill = NULL) +
theme_minimal(base_size = 11) +
theme(
panel.grid.minor = element_blank(),
panel.grid.major.x = element_blank(),
legend.position = "bottom",
legend.key.size = unit(0.5, "cm"),
legend.text = element_text(size = 9),
plot.margin = margin(8, 12, 12, 12)
) +
guides(color = guide_legend(nrow = 3, byrow = TRUE),
fill = guide_legend(nrow = 3, byrow = TRUE))
fig2
