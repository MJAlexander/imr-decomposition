scale_color_manual(values = cause_palette) +
scale_fill_manual(values = cause_palette) +
scale_x_continuous(breaks = seq(2005, 2025, by = 5)) +
labs(x = NULL, y = "Rate effect\n(deaths per 1,000 live births)",
color = NULL, fill = NULL) +
theme_minimal(base_size = 11) +
theme(
panel.grid.minor = element_blank(),
panel.grid.major.x = element_blank(),
legend.position = "bottom",
legend.key.size = unit(0.5, "cm"),
legend.text = element_text(size = 9),
plot.margin = margin(8, 12, 12, 12)
) +
guides(color = guide_legend(nrow = 3, byrow = TRUE),
fill = guide_legend(nrow = 3, byrow = TRUE))
fig2
# Table -------------------------------------------------------------------
all_cause_row <- tibble(
`Cause of death` = "All causes",
`Gap` = fmt_pt_ci(last$total_difference,
last$total_difference_lo,
last$total_difference_hi),
`Composition` = fmt_pt_ci(last$composition_effect,
last$composition_effect_lo,
last$composition_effect_hi),
`Rate` = fmt_pt_ci(last$rate_effect,
last$rate_effect_lo,
last$rate_effect_hi),
`Rate %` = paste0(round(last$rate_pct, 0), "%")
)
cause_rows <- cause_last |>
arrange(desc(gap)) |>
transmute(
`Cause of death` = cause_of_death,
`Gap` = fmt_pt_ci(gap, gap_lo, gap_hi),
`Composition` = fmt_pt_ci(composition_effect, composition_lo, composition_hi),
`Rate` = fmt_pt_ci(rate_effect, rate_lo, rate_hi),
`Rate %` = paste0(round(rate_pct, 0), "%")
)
bind_rows(all_cause_row, cause_rows) |>
kable(align = c("l", "r", "r", "r", "r"))
